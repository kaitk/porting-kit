{
  "app": "fixture",
  "modules": ["*.schemas.ts"],
  "inputs": "Input$",
  "probe": "messages.ts#probe",
  "rust": {
    "out": "rust/src/inputs",
    "dateType": "crate::hooks::Date",
    "dateParse": "crate::hooks::Date::parse",
    "hooks": "crate::hooks",
    "revive": { "dates": true, "booleans": true },
    "types": { "ShareInput.message": "Option<String>" },
    "derives": { "*": ["Debug"] }
  },
  "differential": {
    "runner": "cargo run -q --manifest-path rust/Cargo.toml"
  }
}
